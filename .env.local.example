# Copie este arquivo para .env.local e preencha. NUNCA commite o .env.local.

# Painel do Supabase -> Project Settings -> API Keys (ou "API")
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Usada SOMENTE por scripts locais (seed/backup), na sua maquina.
# Nunca no navegador, nunca com prefixo NEXT_PUBLIC_, nunca na Vercel.
SUPABASE_SECRET_KEY=

# Administrador criado por `npm run seed` (rodado na sua maquina)
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
