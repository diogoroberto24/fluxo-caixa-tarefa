# Copie este arquivo para .env.local e preencha. NUNCA commite o .env.local.

# Painel do Supabase -> Project Settings -> API Keys (ou "API")
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Usada SOMENTE por scripts locais (seed/backup), na sua maquina.
# Nunca no navegador, nunca com prefixo NEXT_PUBLIC_, nunca na Vercel.
SUPABASE_SECRET_KEY=

# Administrador criado por `npm run seed` (rodado na sua maquina)
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Assistente de IA - OPCIONAL. Sem a chave, o item "Assistente IA" fica escondido.
# Chave gratuita em https://aistudio.google.com/apikey. Fica so no servidor: nunca use prefixo NEXT_PUBLIC_.
# Atencao: no plano gratuito o Google pode usar o conteudo enviado para melhorar os produtos dele.
# Use o plano gratuito so com dados de demonstracao; com dados reais de clientes, use o plano pago.
GOOGLE_GENERATIVE_AI_API_KEY=
# Modelo (opcional). Padrao: gemini-3.5-flash
AI_MODEL=
